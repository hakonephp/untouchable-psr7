{
    "name": "hakone/untouchable-psr7",
    "description": "PSR-7 message implementation with all method calls restricted",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Hakone\\Http\\Message\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
